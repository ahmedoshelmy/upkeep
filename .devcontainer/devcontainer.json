{
  "name": "Upkeep",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [8086, 3100, 8025],
  "portsAttributes": {
    "8086": { "label": "Web", "onAutoForward": "openBrowser" },
    "3100": { "label": "GraphQL API (/graphql)" },
    "8025": { "label": "Mailpit (reminder mails)" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "ms-azuretools.vscode-docker"]
    }
  }
}
