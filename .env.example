# Copy to .env for docker compose. Every value here is a local placeholder.
POSTGRES_USER=upkeep
POSTGRES_PASSWORD=change-me
# Lead times in days before a due date (a reminder also fires at the due moment).
LEAD_DAYS=30,7,1
# Seed synthetic demo assets on an empty database.
DEMO_DATA=true
# Optional mail: in compose this points at the local Mailpit inbox (http://localhost:8025). No real mail is sent.
MAIL_SMTP_URL=smtp://mailpit:1025
MAIL_FROM=upkeep@example.com
MAIL_TO=owner@example.com
WORKER_CONCURRENCY=4
# Recorded in each job result (defaults to the container hostname).
# WORKER_NAME=worker-1
# Used when running the API or worker outside compose:
# DATABASE_URL=postgres://upkeep:change-me@localhost:5432/upkeep
# REDIS_URL=redis://localhost:6379
# REMINDER_ATTEMPTS=5
# REMINDER_BACKOFF_MS=5000
# SWEEP_EVERY_MS=900000
# TARIFF_JSON={"currency":"EGP","bands":[...]}
